{
  "comment": "Shared Markdown VIEW grammar cases. Keep identical with agent-webclient src/features/events/lib/__fixtures__/view_markdown_cases.json and agent-platform internal/view/testdata/markdown_cases.json.",
  "cases": [
    {
      "name": "data block",
      "final": true,
      "text": "Intro\n```view key=crm/orders\n{\"items\":[1]}\n```\nAfter",
      "blocks": [
        {
          "index": 0,
          "key": "crm/orders",
          "data": {
            "items": [
              1
            ]
          }
        }
      ]
    },
    {
      "name": "array body and trailing spaces on close",
      "final": true,
      "text": "```view key=crm/orders\n[1,2]\n```  \n",
      "blocks": [
        {
          "index": 0,
          "key": "crm/orders",
          "data": [
            1,
            2
          ]
        }
      ]
    },
    {
      "name": "uppercase word and tab separator",
      "final": true,
      "text": "```VIEW\tkey=crm/orders\n{}\n```",
      "blocks": [
        {
          "index": 0,
          "key": "crm/orders",
          "data": {}
        }
      ]
    },
    {
      "name": "two blocks keep order",
      "final": true,
      "text": "```view key=a/one\n{}\n```\ntext\n```view key=b/two\n{\"x\":1}\n```\n",
      "blocks": [
        {
          "index": 0,
          "key": "a/one",
          "data": {}
        },
        {
          "index": 1,
          "key": "b/two",
          "data": {
            "x": 1
          }
        }
      ]
    },
    {
