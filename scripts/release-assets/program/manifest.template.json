{
  "kind": "builtin",
  "id": "agent-webclient",
  "name": "智能助理",
  "version": "__VERSION__",
  "description": "由 Desktop 托管静态资源和代理路由的 AGENT Web 客户端。",
  "platform": {
    "os": "__TARGET_OS__",
    "arch": "__TARGET_ARCH__"
  },
  "frontend": {
    "mode": "standalone",
    "entry": "/",
    "directAccess": true,
    "hostManaged": true,
    "dist": "frontend/dist",
    "index": "index.html",
    "spa": true,
    "hideFromNav": true,
    "embedPath": "/"
  },
  "lifecycle": {
    "start": [
      "__START_SCRIPT__",
      "--daemon"
    ],
    "stop": "__STOP_SCRIPT__",
    "deploy": "__DEPLOY_SCRIPT__"
  },
  "configFiles": [
    {
      "key": "env",
      "label": ".env",
      "relativePath": ".env",
      "templateRelativePath": ".env.example",
      "required": true
    }
  ],
  "runtime": {
    "requiredPaths": [
      ".env.example",
      "manifest.json",
      "__START_SCRIPT__",
      "__STOP_SCRIPT__",
      "__DEPLOY_SCRIPT__",
      "__PROGRAM_COMMON__",
      "frontend/dist/index.html"
    ]
  },
  "web": {
    "routePath": "/",
    "portEnvKey": "PORT",
    "defaultPort": 11948
  },
  "desktop": {
    "displayOrder": 3,
    "autoStart": true,
    "assetFileName": "__ASSET_FILENAME__",
    "bundleTopLevelDir": "agent-webclient",
    "hosting": {
      "runtimeConfig": {
        "path": "/runtime-config.js",
        "envKeys": [
          "BACKEND_MODE",
          "DESKTOP_APP",
          "DEBUG_PANEL_ENABLED",
          "DEBUG_RUN_OBSERVATION_ENABLED",
          "DELTA_LOGS_ENABLED",
          "SETTINGS_MENU_ENABLED",
          "QUICK_ACTIONS_ENABLED",
          "MEMORY_ENABLED",
          "CONVERSATION_EXPORT_ASSET_ORIGIN",
          "BRAND_ID",
          "VOICE_ENABLED",
          "DICTATION_ENABLED"
        ]
      },
      "spaRoutes": [
        "/login",
        "/agent/",
        "/agents/",
        "/automations",
        "/copilot/",
        "/chat-preview/",
        "/overview/",
        "/debug/",
        "/btw/",
        "/explain/",
        "/source-viewer/",
        "/planning-viewer/",
        "/view-viewer/",
        "/resource-viewer/",
        "/file-viewer/",
        "/web-viewer",
        "/skill-viewer/",
        "/history",
        "/terminal/",
        "/project/",
        "/memory"
      ],
      "proxyRoutes": [
        {
          "match": "exact",
          "path": "/api/dictation/capabilities",
          "targetEnv": "DICTATION_BASE_URL",
          "http": true,
          "websocket": false,
          "optional": true,
          "auth": "agent-platform-access-token",
          "disabledResponse": {
            "status": 503,
            "json": {
              "code": 503,
              "msg": "dictation unavailable"
            }
          }
        },
        {
          "match": "exact",
          "path": "/api/dictation/ws",
          "targetEnv": "DICTATION_BASE_URL",
          "http": false,
          "websocket": true,
          "optional": true,
          "auth": "agent-platform-access-token",
          "stripRequestHeaders": [
            "sec-websocket-extensions"
          ]
        },
        {
          "match": "exact",
          "path": "/api/voice/ws",
          "targetEnv": "BASE_URL",
          "http": false,
          "websocket": true,
          "auth": "agent-platform-access-token",
          "stripRequestHeaders": [
            "sec-websocket-extensions"
          ]
        },
        {
          "match": "prefix",
          "path": "/api",
          "targetEnv": "BASE_URL",
          "http": true,
          "websocket": false,
          "auth": "agent-platform-access-token"
        }
      ]
    },
    "capabilities": {
      "provides": [],
      "requires": [
        {
          "phase": "verifyRunning",
          "capability": "auth.accessToken",
          "action": "preload"
        },
        {
          "phase": "verifyRunning",
          "service": "agent-platform",
          "action": "waitHttp",
          "target": "/healthz"
        }
      ]
    },
    "envBindings": [
      {
        "key": "DICTATION_BASE_URL",
        "fromService": "agent-dictation",
        "template": "http://127.0.0.1:{{port}}",
        "onlyIfDefault": true,
        "defaults": [
          "",
          "http://127.0.0.1:11964"
        ]
      }
    ]
  }
}
