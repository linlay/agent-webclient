{
  "name": "agent-webclient",
  "private": true,
  "version": "0.0.1",
  "description": "AGENT protocol debugging web client",
  "scripts": {
    "start": "npm run start:web",
    "start:web": "npm run build:conversation-export && dotenv -e .env -- webpack serve --mode development",
    "build": "npm run check:desktop-contract && npm run build:web && npm run build:conversation-export && npm run check:conversation-export",
    "build:web": "dotenv -e .env -- webpack --mode production",
    "build:conversation-export": "webpack --config webpack.export.config.js && node ./scripts/build-conversation-export-template.js",
    "sync:conversation-export": "node ./scripts/sync-conversation-export-artifacts.js",
    "check:conversation-export-sync": "node ./scripts/sync-conversation-export-artifacts.js --check",
    "test": "node ./node_modules/jest/bin/jest.js --passWithNoTests --watchman=false",
    "check:boundaries": "node ./scripts/check-feature-boundaries.js",
    "check:desktop-contract": "node ./scripts/check-agent-webclient-contract.js",
    "check:conversation-export": "node ./scripts/check-conversation-export-template.js",
    "check:i18n": "node ./scripts/check-i18n.js"
  },
  "dependencies": {
    "@ant-design/x-markdown": "2.8.0",
    "@dnd-kit/core": "6.0.8",
    "@dnd-kit/sortable": "7.0.2",
    "@dnd-kit/utilities": "3.2.1",
    "@pierre/diffs": "1.2.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "^5.0.0",
    "dompurify": "3.4.13",
    "echarts": "6.0.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "lodash": "4.18.1",
    "mermaid": "11.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.15.0",
    "react-virtuoso": "4.18.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.4",
    "css-loader": "7.1.4",
    "dotenv-cli": "6.0.0",
    "html-webpack-plugin": "5.6.8",
    "jest": "29.7.0",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.23",
    "postcss-loader": "8.2.1",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  }
}
