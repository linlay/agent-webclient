# Local development configuration
# PORT=11948
# BASE_URL=http://localhost:11949
# VOICE_BASE_URL=http://localhost:11953
# Public Tunnel origin used by downloaded HTML exports. HTTPS is required except
# for loopback development origins.
# CONVERSATION_EXPORT_ASSET_ORIGIN=http://127.0.0.1:11961
# Backend connection mode. Defaults to platform for backwards compatibility.
# Use gateway when BASE_URL points to agent-gateway and browser login/session is required.
# BACKEND_MODE=platform
# Standalone WebClient must stay explicit; Desktop bundles inject true from the host.
DESKTOP_APP=false

# Optional frontend entrypoints. Hidden unless explicitly set to true.
# DEBUG_PANEL_ENABLED=true
# DEBUG_RUN_OBSERVATION_ENABLED=true
# DELTA_LOGS_ENABLED=true
# SETTINGS_MENU_ENABLED=true
# QUICK_ACTIONS_ENABLED=true
# MEMORY_ENABLED=true

# Frontend ASR client gate defaults
# These values control browser-side filtering before audio is sent as asr.audio.append.
# Higher RMS threshold filters more light voice / background noise.
# VOICE_ASR_CLIENT_GATE_ENABLED=true
# VOICE_ASR_CLIENT_GATE_RMS_THRESHOLD=0.015
# VOICE_ASR_CLIENT_GATE_OPEN_HOLD_MS=120
# VOICE_ASR_CLIENT_GATE_CLOSE_HOLD_MS=480
# VOICE_ASR_CLIENT_GATE_PRE_ROLL_MS=240
